# ============================================================================
# MiForge OS - local dev environment variables.
# Copy this file to .env and run:   cp .env.example .env
# Every value below is a real, development-safe default for THIS laptop only.
# Nothing here is a production secret. Never commit your .env.
# ============================================================================

# ---- Postgres 16 (shared: nocodb, nextcloud, n8n, formbricks, chatwoot) ----
POSTGRES_USER=miforge
POSTGRES_PASSWORD=miforge-dev-2025
POSTGRES_DB=miforge

# ---- MariaDB 11 (Invoice Ninja only, db `ninja`) ----
MARIADB_ROOT_PASSWORD=miforge-dev-2025
MARIADB_USER=ninja
MARIADB_PASSWORD=miforge-dev-2025

# ---- Nextcloud (admin created on first boot) ----
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=miforge-dev-2025

# ---- Vaultwarden admin panel: http://localhost:8082/admin ----
VAULTWARDEN_ADMIN_TOKEN=miforge-dev-2025

# ---- Invoice Ninja (base64 32-byte dev APP_KEY, `php artisan key:generate` format) ----
IN_APP_KEY=base64:md4LJ4fYajV5oJgWhzuSrQx0UqfOhTz2NjoOT3LlNqM=

# ---- n8n (encryption key for credentials; any long random string) ----
N8N_ENCRYPTION_KEY=miforge-dev-2025-n8n-encryption-key-32b

# ---- Uptime Kuma (admin auto-created by the kuma-setup one-shot) ----
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=miforge-dev-2025

# ---- Chatwoot ----
CHATWOOT_SECRET_KEY_BASE=920e7197691576ccd594870c9919bfcb645d8a8bb76415f3981f2464629df9a81769f140e8949cf3d479f8f144e20c0feba113b2fd42bdd3413e96d2fa9a9d97

# ---- Formbricks ----
FORMBRICKS_NEXTAUTH_SECRET=miforge-dev-2025
# must be exactly 32 chars:
FORMBRICKS_ENCRYPTION_KEY=miforge-dev-2025-encryptionkey!!

# ---- NocoDB first-run signup (creates the owner account) ----
NOCODB_ADMIN_EMAIL=operator@miforge.local
NOCODB_ADMIN_PASSWORD=miforge-dev-2025

# ---- Invoice Ninja first-run login (used by ninja-setup / post-setup) ----
NINJA_ADMIN_EMAIL=admin@miforge.local
NINJA_ADMIN_PASSWORD=miforge-dev-2025

# ---- n8n mock SMTP credential (create in n8n UI as "MiForge Dev SMTP (mock)") ----
# host: smtp.miforge.local   port: 587   user: n8n@miforge.local   pass: miforge-dev-2025
N8N_MOCK_SMTP_HOST=smtp.miforge.local
N8N_MOCK_SMTP_PORT=587
N8N_MOCK_SMTP_USER=n8n@miforge.local
N8N_MOCK_SMTP_PASSWORD=miforge-dev-2025
