      "position": [480, 300],
      "credentials": {
        "smtp": {
          "id": "miforge-dev-smtp-mock",
          "name": "MiForge Dev SMTP (mock)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ntfy:80/miforge-clients",
        "sendHeaders": true,
        "headerParameters": {
