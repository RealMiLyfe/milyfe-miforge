---
import '../styles/global.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · MiForge Founder Services</title>
    <meta
      name="description"
      content="MiForge Founder Services (miforgefs.milyfe.fun) - in-home tech help in Jacksonville, FL. Sessions, projects, and partnerships for seniors, churches, and families. Part of the MiLyfe economy."
    />
    <!--
      PRODUCTION: load Lora + Inter here (e.g. Google Fonts <link rel="preload">).
      Local dev intentionally uses system font stacks - no external font CDNs,
      so the site works fully offline.
    -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MiForge Founder Services" />
    <meta property="og:title" content="MiForge Founder Services — in-home tech help in Jacksonville, FL" />
    <meta property="og:description" content="Sessions, projects, and partnerships for seniors, churches, and families. Call or text 904-562-0544." />
    <meta property="og:image" content="https://miforgefs.milyfe.fun/og-image.png" />
    <meta property="og:url" content="https://miforgefs.milyfe.fun/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://miforgefs.milyfe.fun/og-image.png" />
    <!-- No analytics, tracking, or telemetry scripts. None. -->
  </head>
  <body class="bg-cream font-body text-charcoal">
    <!-- DEMO MODE strip on every page - remove at Go-Live (see docs/brand.md) -->
    <div class="bg-warn px-4 py-1 text-center text-xs font-semibold text-charcoal">
      Local demo — not live. All data is fake except Client #001 reference.
    </div>
    <!-- Sticky top band, 80px -->
    <header class="sticky top-0 z-50 h-20 border-b border-navy/20 bg-cream">
      <div class="mx-auto flex h-20 max-w-6xl items-center justify-between gap-4 px-4">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo.png" alt="MiLyfe" class="h-10 w-auto" />
          <span class="font-head text-2xl font-bold text-navy">
            MiForge <span class="hidden text-lg font-normal sm:inline">Founder Services</span>
          </span>
        </a>
        <a href="tel:9045620544" class="btn-rust text-lg sm:text-xl">
          Call or Text 904-562-0544
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-navy/20 py-8">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 text-lg sm:flex-row sm:items-center sm:justify-between">
        <p>MiForge Founder Services · miforgefs.milyfe.fun · part of the MiLyfe economy · Jacksonville, FL</p>
        <p class="flex gap-6">
          <a href="/trust" class="font-semibold text-navy underline">Privacy &amp; Trust Agreement</a>
          <a href="tel:9045620544" class="font-semibold text-navy underline">904-562-0544</a>
        </p>
      </div>
    </footer>
  </body>
</html>
