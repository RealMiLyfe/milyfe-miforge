---
import Layout from '../layouts/Layout.astro';
import flags from '../data/flags.json';

const pillars = [
  {
    name: 'Session',
    price: '$100/hr, 2hr min',
    tagline: "I'll do it for you.",
    bullets: ['Set up a new printer', 'Transfer photos off an old phone', 'Clear out junk email'],
  },
  {
    name: 'Project',
    price: '$300–$1,500 flat',
    tagline: "I'll build you something that works.",
    bullets: ['Organize your digital photos', 'Build a family newsletter', 'Set up a video calling station'],
  },
  {
    name: 'Partnership',
    price: '$200/month',
    tagline: "I'll be your tech person.",
    bullets: ['Monthly check-in visits', 'Priority scheduling', 'Family coordination'],
  },
];

const serve = [
  ['👴', 'Seniors'],
  ['🕊️', 'Widows & Widowers'],
  ['⛪', 'Small Churches'],
  ['📋', 'Estate Executors'],
  ['💼', 'Retired Professionals'],
  ['🤝', 'Family Caregivers'],
];

const steps = [
  ['1', 'Call or text'],
  ['2', 'Free 15-min talk'],
  ['3', 'I come to you'],
  ['4', 'Problem handled'],
];

const trustAlways = [
  'I return every call within 24 hours.',
  'Every client gets a Privacy & Trust Agreement.',
  'Your family can be involved as much as you want.',
  "I'm local to Jacksonville.",
];
---

<Layout title="In-home tech help in Jacksonville, FL">
  <!-- ============================ HERO (one viewport) ============================ -->
  <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 md:min-h-[calc(100vh-80px)] md:grid-cols-2">
    <div>
      <h1 class="text-5xl leading-tight md:text-[56px]">
        Technology, translated for how you actually live.
      </h1>
      <p class="measure mt-6 text-2xl">
        I come to your home in Jacksonville and fix the thing — then I teach you how it works.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="tel:9045620544" class="btn-rust text-xl">Call 904-562-0544</a>
        <a href="#pillars" class="btn-navy-outline text-xl">See What I Do</a>
      </div>
    </div>
    <div
      class="mx-auto flex h-[400px] w-full max-w-[400px] items-center justify-center rounded-card border-2 border-dashed border-charcoal/40 bg-charcoal/10 text-xl text-charcoal/70"
    >
      Carnell Lee — photo pending
    </div>
  </section>

  <!-- ============================ THREE PILLARS ============================ -->
  <section id="pillars" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16">
    <h2 class="text-4xl">Three ways to work together</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        pillars.map((p) => (
          <article class="card flex min-h-[400px] flex-col p-8">
            <h3 class="text-3xl">{p.name}</h3>
            <p class="mt-2 text-2xl font-bold text-rust">{p.price}</p>
            <p class="mt-4 text-xl font-semibold">{p.tagline}</p>
            <ul class="mt-4 list-disc space-y-2 pl-6 text-xl">
              {p.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============================ WHO I SERVE ============================ -->
  <section id="serve" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16">
    <h2 class="text-4xl">Who I serve</h2>
    <p class="measure mt-6 text-xl">
      Most of my clients are people who didn't grow up with computers — and that's exactly who I
      like working with. If technology has started feeling frustrating, confusing, or a little
      scary, you're in good company. I speak plain English, I go at your pace, and I never make
      you feel silly for asking.
    </p>
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        serve.map(([icon, label]) => (
          <div class="card flex min-h-touch items-center gap-4 p-4">
            <span class="text-4xl" aria-hidden="true">{icon}</span>
            <span class="text-xl font-semibold">{label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============================ HOW IT WORKS ============================ -->
  <section id="how" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16">
    <h2 class="text-4xl">How it works</h2>
    <ol class="mt-8 flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      {
        steps.map(([n, label]) => (
          <li class="flex items-center gap-4 md:flex-col md:text-center">
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-pill bg-navy font-head text-2xl font-bold text-cream">
              {n}
            </span>
            <span class="text-xl font-semibold">{label}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============================ TRUST ============================ -->
  <section id="trust" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16">
    <h2 class="text-4xl">Why you can trust me</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        trustAlways.map((t) => (
          <div class="card p-6">
            <p class="text-xl">
              <span class="mr-2 font-bold text-success" aria-hidden="true">✓</span>
              {t}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Feature-flagged claims: rendered as grey placeholders while flags are OFF -->
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="card-hidden-flag">
        <p class="text-xl font-semibold">☐ Background checked</p>
        <p class="mt-1">HIDDEN — flag <code>background_checked</code>: OFF</p>
      </div>
      <div class="card-hidden-flag">
        <p class="text-xl font-semibold">☐ Fully insured</p>
        <p class="mt-1">HIDDEN — flag <code>insured</code>: OFF</p>
      </div>
      <div class="card-hidden-flag md:col-span-2">
        <p class="text-xl font-semibold">☐ Client testimonial</p>
        <p class="mt-1">HIDDEN — flag <code>testimonials</code>: OFF ({flags.testimonial_note})</p>
      </div>
    </div>

    <p class="measure mt-6 text-xl">
      The full promises are written in plain English on our{' '}
      <a href="/trust" class="font-semibold text-navy underline">Privacy &amp; Trust Agreement</a>.
    </p>
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section id="contact" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16">
    <h2 class="text-4xl">Talk to a person today</h2>
    <p class="mt-6">
      <a href="tel:9045620544" class="font-head text-5xl font-bold text-navy underline md:text-6xl">
        904-562-0544
      </a>
    </p>
    <p class="mt-2 text-xl">Call or text. If I'm with a client, I'll call you back within 24 hours.</p>
    <p class="mt-1 text-lg text-charcoal/80">Hours: Tue–Thu 9–5 · Fri 9–3 · Sat 10–2 by appointment · Sun–Mon off. Service area: Jacksonville, FL only.</p>

    <form id="contact-form" class="card mt-8 max-w-xl p-6" novalidate>
      <div class="space-y-4">
        <div>
          <label for="name" class="mb-1 block font-semibold">Name</label>
          <input id="name" name="name" type="text" class="field" required autocomplete="name" />
        </div>
        <div>
          <label for="phone" class="mb-1 block font-semibold">Phone</label>
          <input id="phone" name="phone" type="tel" class="field" required autocomplete="tel" />
        </div>
        <div>
          <label for="message" class="mb-1 block font-semibold">What's going on?</label>
          <textarea id="message" name="message" rows="4" class="field" required></textarea>
        </div>
      </div>
      <!-- Mock only: no backend. Shows a success state on click. -->
      <button type="submit" class="btn-rust mt-6 w-full text-xl">Submit</button>
    </form>

    <div id="form-success" class="card hidden max-w-xl border-success p-6" role="status">
      <p class="text-2xl font-bold text-success">Thanks! Carnell will call you within 24 hours.</p>
      <p class="mt-2 text-xl">
        If it's urgent, call or text <a href="tel:9045620544" class="font-semibold text-navy underline">904-562-0544</a>.
      </p>
      <p class="mt-2"><a href="/thanks" class="font-semibold text-navy underline">See the confirmation page</a></p>
    </div>

    <script>
      const form = document.getElementById('contact-form');
      const success = document.getElementById('form-success');
      form?.addEventListener('submit', (e) => {
        e.preventDefault(); // mock: nothing is sent anywhere
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      });
    </script>
  </section>
</Layout>
