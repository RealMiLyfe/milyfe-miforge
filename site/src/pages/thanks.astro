---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thanks for reaching out">
  <section class="mx-auto max-w-measure px-4 py-24 text-center">
    <h1 class="text-5xl">Thanks for reaching out!</h1>
    <p class="mt-6 text-2xl">John will call you back within 24 hours.</p>
    <p class="mt-4 text-2xl">
      If it's urgent, call or text
      <a href="tel:9045620544" class="font-semibold text-navy underline">904-562-0544</a>.
    </p>
    <p class="mt-8">
      <a href="/" class="btn-rust text-xl">Back to the home page</a>
    </p>
  </section>
</Layout>
